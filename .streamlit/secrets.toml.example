# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Cloud > App settings > Secrets.
# Never commit the real file.
UPSTOX_API_KEY = "your-api-key"
UPSTOX_API_SECRET = "your-api-secret"
UPSTOX_REDIRECT_URI = "https://your-app.streamlit.app"   # or http://localhost:8501 locally
APP_PASSWORD = "pick-a-password"                          # optional extra lock

# Trading (Trade tab). Leave these out to keep the app in paper mode.
# LIVE_TRADING = true
# TRADE_PIN = "a-pin-only-you-know"          # typed in for every live order
# MAX_ORDER_VALUE = 50000                    # optional per-order cap in rupees
# UPSTOX_SANDBOX_TOKEN = "sandbox-token"     # optional, for Upstox's test system

# Company tab: lets Claude read any company's filings to fill in "Sells & buys" (optional).
# Get a key at https://console.anthropic.com. Each company costs a few rupees of API credit.
# ANTHROPIC_API_KEY = "sk-ant-..."
